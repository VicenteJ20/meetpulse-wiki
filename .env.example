R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=meetpulse-wiki
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
GOOGLE_OAUTH_CLIENT_ID=
# Additional accepted ID-token audiences, including Clara's Google web client ID.
GOOGLE_OAUTH_CLIENT_IDS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
AI_GATEWAY_API_KEY=
LIBRARIAN_MODEL=google/gemini-3.1-flash-lite
LIBRARIAN_THINKING_LEVEL=minimal
LIBRARIAN_PROVIDER_ORDER=google,vertex
LIBRARIAN_FALLBACK_MODEL=
LIBRARIAN_WEBHOOK_SECRET=
REQUIRE_RAW_SOURCE=false
# Optional comma-separated browser origins for additional web clients.
# Tauri desktop origins and local development origins are allowed by default.
# Example: https://app.meetpulse.com
CORS_ALLOWED_ORIGINS=
